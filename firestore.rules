rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default-deny all unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    // --- HARDENED GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidColorKey(val) {
      return val in ['CORAL', 'TEAL', 'AMBER', 'VIOLET', 'SKY', 'BERRY'];
    }

    function isValidRepeatRule(val) {
      return val in ['NONE', 'DAILY', 'WEEKDAYS', 'WEEKLY', 'MONTHLY'];
    }

    function isValidSubtaskEntry(entry) {
      return entry is map &&
        entry.keys().hasAll(['id', 'title', 'done']) &&
        entry.keys().hasOnly(['id', 'title', 'done']) &&
        entry.id is string && entry.id.size() >= 1 && entry.id.size() <= 64 &&
        entry.title is string && entry.title.size() >= 1 && entry.title.size() <= 120 &&
        entry.done is bool;
    }

    function isValidTask(data, ownerId) {
      return data.keys().hasAll([
          'userId', 'title', 'notes', 'completed', 'colorKey',
          'repeatRule', 'repeatInterval', 'subtasks', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'title', 'notes', 'completed', 'colorKey',
          'dueDateMillis', 'reminderMillis', 'repeatRule', 'repeatInterval',
          'subtasks', 'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId == ownerId && data.userId == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.notes is string && data.notes.size() <= 500 &&
        data.completed is bool &&
        data.colorKey is string && data.colorKey.size() <= 16 && isValidColorKey(data.colorKey) &&
        (!('dueDateMillis' in data) || data.dueDateMillis == null || (data.dueDateMillis is int && data.dueDateMillis > 0)) &&
        (!('reminderMillis' in data) || data.reminderMillis == null || (data.reminderMillis is int && data.reminderMillis > 0)) &&
        data.repeatRule is string && data.repeatRule.size() <= 16 && isValidRepeatRule(data.repeatRule) &&
        data.repeatInterval is int && data.repeatInterval >= 1 && data.repeatInterval <= 365 &&
        data.subtasks is list && data.subtasks.size() <= 30 &&
        (data.subtasks.size() == 0 || isValidSubtaskEntry(data.subtasks[0])) &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Named update actions for strict affectedKeys enforcement
    function isToggleCompletionAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'completed', 'dueDateMillis', 'reminderMillis', 'subtasks', 'updatedAt'
      ]);
    }

    function isUpdateSubtasksAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'subtasks', 'updatedAt'
      ]);
    }

    function isEditTaskAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'title', 'notes', 'completed', 'colorKey',
        'dueDateMillis', 'reminderMillis', 'repeatRule', 'repeatInterval',
        'subtasks', 'updatedAt'
      ]);
    }

    // --- USER-SCOPED TASKS SUBCOLLECTION ---
    match /users/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(taskId);

      // User-scoped subcollection list relies strictly on path wildcard ownership
      allow list: if isOwner(userId) && isValidId(userId);

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidId(taskId) &&
        isValidTask(incoming(), userId);

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidId(taskId) &&
        isValidTask(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        (
          isToggleCompletionAction() ||
          isUpdateSubtasksAction() ||
          isEditTaskAction()
        );

      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(taskId);
    }
  }
}
