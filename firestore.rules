rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened security primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidMood(mood) {
      return mood is string && mood in ['CALM', 'JOYFUL', 'GRATEFUL', 'REFLECTIVE', 'TIRED', 'ANXIOUS'];
    }

    function isValidTags(tags) {
      return tags is list &&
             tags.size() <= 8 &&
             (tags.size() == 0 || (tags[0] is string && tags[0].size() >= 1 && tags[0].size() <= 30));
    }

    // Standalone validation blueprint for JournalEntry
    function isValidJournalEntry(data, userId) {
      return data.keys().hasAll([
               'userId', 'title', 'content', 'mood', 'favorite',
               'tags', 'wordCount', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'title', 'content', 'mood', 'favorite',
               'tags', 'wordCount', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId == userId && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 20000 &&
             isValidMood(data.mood) &&
             data.favorite is bool &&
             isValidTags(data.tags) &&
             data.wordCount is int && data.wordCount >= 0 && data.wordCount <= 20000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Private user-scoped journal entries
    match /users/{userId}/entries/{entryId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(entryId);
      allow list: if isOwner(userId) && isValidId(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(entryId) &&
                       isValidJournalEntry(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(entryId) &&
                       isValidJournalEntry(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action: Edit full journal entry content/metadata
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'content', 'mood', 'favorite', 'tags', 'wordCount', 'updatedAt'
                         ]) ||
                         // Action: Toggle favorite bookmark
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'favorite', 'updatedAt'
                         ])
                       );

      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(entryId);
    }
  }
}
