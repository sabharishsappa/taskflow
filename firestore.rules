rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened security primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCategory(cat) {
      return cat in ['REFLECTION', 'ACTIVITY', 'EVENT', 'MILESTONE', 'TRAVEL', 'IDEA'];
    }

    function isValidJournalEntry(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.heading is string && data.heading.size() >= 1 && data.heading.size() <= 200 &&
             data.body is string && data.body.size() <= 20000 &&
             data.entryDateMillis is int && data.entryDateMillis > 0 &&
             data.category is string && data.category.size() <= 32 && isValidCategory(data.category) &&
             data.locationName is string && data.locationName.size() <= 200 &&
             (!('locationLat' in data) || data.locationLat == null || (data.locationLat is number && data.locationLat >= -90 && data.locationLat <= 90)) &&
             (!('locationLng' in data) || data.locationLng == null || (data.locationLng is number && data.locationLng >= -180 && data.locationLng <= 180)) &&
             data.tags is list && data.tags.size() <= 10 &&
             (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() >= 1 && data.tags[0].size() <= 32)) &&
             data.attachments is list && data.attachments.size() <= 10 &&
             (data.attachments.size() == 0 || data.attachments[0] is map) &&
             data.bookmarked is bool &&
             data.wordCount is int && data.wordCount >= 0 && data.wordCount <= 50000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId}/entries/{entryId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(entryId);
      allow list: if isOwner(userId) && isValidId(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(entryId) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll([
                         'userId', 'heading', 'body', 'entryDateMillis', 'category',
                         'locationName', 'tags', 'attachments', 'bookmarked',
                         'wordCount', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'heading', 'body', 'entryDateMillis', 'category',
                         'locationName', 'locationLat', 'locationLng', 'tags',
                         'attachments', 'bookmarked', 'wordCount', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidJournalEntry(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(entryId) &&
                       isValidJournalEntry(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action 1: Toggle bookmark status
                         incoming().diff(existing()).affectedKeys().hasOnly(['bookmarked', 'updatedAt']) ||
                         // Action 2: Full or partial entry edit
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'heading', 'body', 'entryDateMillis', 'category',
                           'locationName', 'locationLat', 'locationLng',
                           'tags', 'attachments', 'bookmarked', 'wordCount', 'updatedAt'
                         ])
                       );

      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(entryId);
    }
  }
}
